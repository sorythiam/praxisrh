# Copy to infra/.env and adjust before running `docker compose up`.
# All of this stays on your own infrastructure — nothing here is sent
# to a third party, which is what makes self-hosting for CDP Sénégal
# data-residency compliance possible.

POSTGRES_USER=praxis
POSTGRES_PASSWORD=change-me
POSTGRES_DB=praxis

# Generate a real secret: openssl rand -base64 48
JWT_SECRET=change-me-in-production

# Public origin of the web app (used for CORS on the API).
WEB_ORIGIN=http://localhost:3000
