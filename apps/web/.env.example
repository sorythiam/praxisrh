# Base URL of the Praxis API (no trailing /api — next.config.js appends
# it). Local dev defaults to http://localhost:4000 if unset.
# In production (e.g. Vercel), point this at the deployed API's public
# URL (e.g. a Railway domain: https://praxis-api.up.railway.app).
API_URL="http://localhost:4000"
