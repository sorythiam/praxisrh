// Praxis — Prisma schema
//
// Tenant isolation strategy (defense in depth):
//  1. Application layer: every tenant-scoped model below carries a
//     `tenantId` column. All access from application code goes through
//     a Prisma Client Extension (see src/core/prisma/tenant-scoping.extension.ts)
//     that automatically injects/verifies `tenantId` on every query. No
//     repository is allowed to hand-build a `where` clause with tenantId —
//     the extension does it, which removes an entire class of bugs.
//  2. Database layer: PostgreSQL Row-Level Security policies (see
//     prisma/rls.sql) are enabled on every tenant-scoped table as a
//     backstop, keyed on the `app.tenant_id` session variable set by the
//     API for the duration of each request transaction.
//  3. IPM, Pack Intérim, Formation and Engagement models are present
//     here (so the schema never needs a breaking migration when those
//     are built) but their business logic is intentionally not
//     implemented yet — see docs/ARCHITECTURE.md. Talents, Performance/
//     OKR and Recruitment (Phase 2) ARE fully implemented.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// Core: tenants, modules, subscription, auth, persons, cross-cutting
// ---------------------------------------------------------------------

enum ModuleCode {
  RH
  IPM
  INTERIM
}

enum Role {
  PRAXIS_ADMIN
  COMPANY_ADMIN
  HR_ADMIN
  IPM_MANAGER
  MANAGER
  EMPLOYEE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

model Tenant {
  id            String    @id @default(uuid())
  name          String
  sector        String?
  countryCode   String    @default("SN")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  establishments    Establishment[]
  moduleActivations ModuleActivation[]
  subscription      Subscription?
  users             User[]
  persons           Person[]
  employees         Employee[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  paymentTransactions PaymentTransaction[]
  competences       Competence[]
  postesInternes    PosteInterne[]

  @@map("tenants")
}

model Establishment {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  city      String?
  createdAt DateTime @default(now())

  employees Employee[]
  shifts    Shift[]
  jobPostings JobPosting[]

  @@index([tenantId])
  @@map("establishments")
}

model ModuleActivation {
  id           String     @id @default(uuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  moduleCode   ModuleCode
  isActive     Boolean    @default(true)
  activatedAt  DateTime   @default(now())
  deactivatedAt DateTime?

  @@unique([tenantId, moduleCode])
  @@index([tenantId])
  @@map("module_activations")
}

model Subscription {
  id               String             @id @default(uuid())
  tenantId         String             @unique
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status           SubscriptionStatus @default(TRIALING)
  billingCycle     BillingCycle       @default(MONTHLY)
  trialEndsAt      DateTime
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@map("subscriptions")
}

model User {
  id           String    @id @default(uuid())
  tenantId     String?   // null only for PRAXIS_ADMIN accounts
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String?
  phone        String?
  passwordHash String
  role         Role
  personId     String?   @unique
  person       Person?   @relation(fields: [personId], references: [id])
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  managedEmployees Employee[] @relation("EmployeeManager")

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("users")
}

// A Person exists once per tenant and is enriched by whichever modules
// are active (Employee for RH, Beneficiary for IPM, Interimaire for Pack Intérim).
model Person {
  id                 String   @id @default(uuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firstName          String
  lastName            String
  dateOfBirth        DateTime?
  nationalId         String?
  phone              String?
  email              String?
  mobileMoneyProvider String? // WAVE | ORANGE_MONEY
  mobileMoneyNumber  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user     User?
  employee Employee?

  @@index([tenantId])
  @@map("persons")
}

model CountryRuleSet {
  id             String   @id @default(uuid())
  countryCode    String
  effectiveFrom  DateTime
  payload        Json     // full CountryRuleSet shape from @praxis/shared
  createdAt      DateTime @default(now())

  @@unique([countryCode, effectiveFrom])
  @@map("country_rule_sets")
}

enum PaymentTransactionType {
  SUBSCRIPTION
  SALARY
  ADVANCE
  REIMBURSEMENT
}

enum PayoutProvider {
  WAVE
  ORANGE_MONEY
}

enum PayoutStatus {
  PENDING
  INITIATED
  SUCCESS
  FAILED
}

model PaymentTransaction {
  id            String                 @id @default(uuid())
  tenantId      String
  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type          PaymentTransactionType
  provider      PayoutProvider
  amountFcfa    Int
  status        PayoutStatus           @default(PENDING)
  personId      String?
  reference     String                 @unique
  failureReason String?
  initiatedAt   DateTime               @default(now())
  settledAt     DateTime?

  payoutItem PayoutItem?

  @@index([tenantId])
  @@map("payment_transactions")
}

enum NotificationChannel {
  WHATSAPP
  SMS
  EMAIL
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

model Notification {
  id        String             @id @default(uuid())
  tenantId  String
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  personId  String?
  channel   NotificationChannel
  template  String
  payload   Json
  status    NotificationStatus @default(QUEUED)
  createdAt DateTime           @default(now())
  sentAt    DateTime?

  @@index([tenantId])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUserId String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------
// Praxis RH
// ---------------------------------------------------------------------

enum EmploymentCategory {
  ouvrier
  employe
  agent_maitrise
  cadre
}

enum EmployeeStatus {
  ONBOARDING
  ACTIVE
  ON_LEAVE
  SUSPENDED
  OFFBOARDING
  TERMINATED
}

model Employee {
  id                 String             @id @default(uuid())
  tenantId           String
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  personId           String             @unique
  person             Person             @relation(fields: [personId], references: [id], onDelete: Cascade)
  employeeNumber     String
  establishmentId    String?
  establishment      Establishment?     @relation(fields: [establishmentId], references: [id])
  position           String
  department         String?
  employmentCategory EmploymentCategory @default(employe)
  status             EmployeeStatus     @default(ONBOARDING)
  hireDate           DateTime
  endDate            DateTime?
  managerUserId      String?
  manager            User?              @relation("EmployeeManager", fields: [managerUserId], references: [id])
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  contracts      Contract[]
  shifts         Shift[]
  clockEvents    ClockEvent[]
  leaveBalances  LeaveBalance[]
  leaveRequests  LeaveRequest[]
  payslipLines   PayslipLine[]
  payslips       Payslip[]
  competences          EmployeeCompetence[]
  posteInterneApplications PosteInterneApplication[]
  developmentPlans     DevelopmentPlan[]
  successionCandidacies SuccessionCandidate[]
  objectives           Objective[]
  feedbackReceived     Feedback[]
  performanceReviews   PerformanceReview[]
  ipmBeneficiary       IpmBeneficiary?

  @@unique([tenantId, employeeNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("employees")
}

enum ContractType {
  CDI
  CDD
  STAGE
  PRESTATION
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURE
  ACTIVE
  ENDED
  TERMINATED
}

model Contract {
  id             String         @id @default(uuid())
  tenantId       String
  employeeId     String
  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type           ContractType
  status         ContractStatus @default(DRAFT)
  startDate      DateTime
  endDate        DateTime?
  trialEndDate   DateTime?
  baseSalaryFcfa Int
  weeklyHours    Int            @default(40)
  documentUrl    String?
  signedAt       DateTime?
  renewalCount   Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("contracts")
}

enum ShiftStatus {
  DRAFT
  PUBLISHED
}

model Shift {
  id              String        @id @default(uuid())
  tenantId        String
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id])
  date            DateTime
  startTime       DateTime
  endTime         DateTime
  status          ShiftStatus   @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([tenantId])
  @@index([tenantId, employeeId, date])
  @@map("shifts")
}

enum ClockEventType {
  CLOCK_IN
  CLOCK_OUT
  BREAK_START
  BREAK_END
}

enum ClockEventSource {
  ONLINE
  OFFLINE_SYNC
}

model ClockEvent {
  id             String           @id @default(uuid())
  tenantId       String
  employeeId     String
  employee       Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type           ClockEventType
  timestamp      DateTime
  source         ClockEventSource @default(ONLINE)
  clientEventId  String           // idempotency key generated offline by the PWA
  latitude       Float?
  longitude      Float?
  photoUrl       String?
  flaggedLate    Boolean          @default(false)
  createdAt      DateTime         @default(now())

  @@unique([tenantId, clientEventId])
  @@index([tenantId])
  @@index([tenantId, employeeId, timestamp])
  @@map("clock_events")
}

enum LeaveType {
  CONGE_PAYE
  MALADIE
  MATERNITE
  PATERNITE
  EVENEMENT_FAMILIAL
  SANS_SOLDE
  AUTRE
}

model LeaveBalance {
  id           String   @id @default(uuid())
  tenantId     String
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType
  year         Int
  accruedDays  Float    @default(0)
  takenDays    Float    @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([employeeId, leaveType, year])
  @@index([tenantId])
  @@map("leave_balances")
}

enum LeaveRequestStatus {
  PENDING_MANAGER
  PENDING_HR
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id               String              @id @default(uuid())
  tenantId         String
  employeeId       String
  employee         Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type             LeaveType
  startDate        DateTime
  endDate          DateTime
  days             Float
  status           LeaveRequestStatus  @default(PENDING_MANAGER)
  reason           String?
  managerDecisionBy String?
  managerDecisionAt DateTime?
  hrDecisionBy     String?
  hrDecisionAt     DateTime?
  rejectionReason  String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("leave_requests")
}

enum PayrollReportStatus {
  DRAFT
  ANOMALY_REVIEW
  VALIDATED
  EXPORTED
  PAID
}

model PayrollReport {
  id           String              @id @default(uuid())
  tenantId     String
  periodYear   Int
  periodMonth  Int
  status       PayrollReportStatus @default(DRAFT)
  generatedAt  DateTime            @default(now())
  validatedAt  DateTime?
  validatedBy  String?
  exportedAt   DateTime?

  lines PayslipLine[]

  @@unique([tenantId, periodYear, periodMonth])
  @@index([tenantId])
  @@map("payroll_reports")
}

model PayslipLine {
  id                    String        @id @default(uuid())
  tenantId              String
  payrollReportId       String
  payrollReport         PayrollReport @relation(fields: [payrollReportId], references: [id], onDelete: Cascade)
  employeeId            String
  employee              Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  baseSalaryFcfa         Int
  overtimeHours          Float         @default(0)
  overtimeAmountFcfa     Int           @default(0)
  bonusesFcfa            Int           @default(0)
  advancesDeductedFcfa   Int           @default(0)
  grossSalaryFcfa        Int
  employeeContributionsFcfa Int        @default(0)
  incomeTaxFcfa           Int          @default(0)
  netSalaryFcfa           Int
  anomalyFlags            Json?        // [{code, message, severity}]
  createdAt               DateTime     @default(now())

  @@unique([payrollReportId, employeeId])
  @@index([tenantId])
  @@map("payslip_lines")
}

model Payslip {
  id            String    @id @default(uuid())
  tenantId      String
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodYear    Int
  periodMonth   Int
  fileUrl       String
  distributedAt DateTime  @default(now())
  firstViewedAt DateTime?

  @@unique([employeeId, periodYear, periodMonth])
  @@index([tenantId])
  @@map("payslips")
}

model PayoutBatch {
  id          String                 @id @default(uuid())
  tenantId    String
  type        PaymentTransactionType
  provider    PayoutProvider
  totalAmountFcfa Int
  status      PayoutStatus           @default(PENDING)
  initiatedBy String?
  initiatedAt DateTime               @default(now())
  completedAt DateTime?

  items PayoutItem[]

  @@index([tenantId])
  @@map("payout_batches")
}

model PayoutItem {
  id              String            @id @default(uuid())
  tenantId        String
  payoutBatchId   String
  payoutBatch     PayoutBatch       @relation(fields: [payoutBatchId], references: [id], onDelete: Cascade)
  personId        String
  amountFcfa      Int
  status          PayoutStatus      @default(PENDING)
  providerReference String?
  failureReason   String?
  paymentTransactionId String?      @unique
  paymentTransaction PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id])

  @@index([tenantId])
  @@map("payout_items")
}

// ---------------------------------------------------------------------
// Praxis RH — Phase 2 (talents & évolution de carrière, section 6.12;
// performance & OKR, 6.13; recrutement/ATS, 6.14). Fully implemented,
// same tenant-isolation guarantees as the rest of Praxis RH.
// ---------------------------------------------------------------------

model Competence {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  category  String?
  createdAt DateTime @default(now())

  employeeCompetences EmployeeCompetence[]
  posteRequirements   PosteInterneRequirement[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("competences")
}

model EmployeeCompetence {
  id           String     @id @default(uuid())
  tenantId     String
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  competenceId String
  competence   Competence @relation(fields: [competenceId], references: [id], onDelete: Cascade)
  level        Int // 1-5
  assessedAt   DateTime   @default(now())

  @@unique([employeeId, competenceId])
  @@index([tenantId])
  @@map("employee_competences")
}

enum PosteInterneStatus {
  OPEN
  FILLED
  ARCHIVED
}

model PosteInterne {
  id           String              @id @default(uuid())
  tenantId     String
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title        String
  department   String?
  isKeyRole    Boolean             @default(false)
  status       PosteInterneStatus  @default(OPEN)
  description  String?
  createdAt    DateTime            @default(now())

  requirements   PosteInterneRequirement[]
  applications   PosteInterneApplication[]
  successionPlan SuccessionPlan?
  developmentPlans DevelopmentPlan[]

  @@index([tenantId])
  @@map("postes_internes")
}

model PosteInterneRequirement {
  id             String       @id @default(uuid())
  tenantId       String
  posteInterneId String
  posteInterne   PosteInterne @relation(fields: [posteInterneId], references: [id], onDelete: Cascade)
  competenceId   String
  competence     Competence   @relation(fields: [competenceId], references: [id], onDelete: Cascade)
  requiredLevel  Int // 1-5

  @@unique([posteInterneId, competenceId])
  @@index([tenantId])
  @@map("poste_interne_requirements")
}

enum PosteInterneApplicationStatus {
  INTERESSE
  EN_EVALUATION
  RETENU
  REJETE
}

model PosteInterneApplication {
  id             String                          @id @default(uuid())
  tenantId       String
  posteInterneId String
  posteInterne   PosteInterne                    @relation(fields: [posteInterneId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee                        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  status         PosteInterneApplicationStatus   @default(INTERESSE)
  message        String?
  createdAt      DateTime                        @default(now())

  @@unique([posteInterneId, employeeId])
  @@index([tenantId])
  @@map("poste_interne_applications")
}

model DevelopmentPlan {
  id                 String        @id @default(uuid())
  tenantId           String
  employeeId         String
  employee           Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  targetPosteInterneId String?
  targetPosteInterne PosteInterne? @relation(fields: [targetPosteInterneId], references: [id])
  goals              String
  recommendedActions Json? // [{label, type}] — free-form until Formation module consumes it
  createdAt          DateTime      @default(now())
  lastReviewedAt     DateTime?

  @@index([tenantId])
  @@map("development_plans")
}

enum SuccessionReadiness {
  READY_NOW
  READY_1_2_YEARS
  READY_3_5_YEARS
  DEVELOPING
}

model SuccessionPlan {
  id                  String       @id @default(uuid())
  tenantId            String
  posteInterneId      String       @unique
  posteInterne        PosteInterne @relation(fields: [posteInterneId], references: [id], onDelete: Cascade)
  currentHolderEmployeeId String?
  notes               String?
  createdAt           DateTime     @default(now())

  candidates SuccessionCandidate[]

  @@index([tenantId])
  @@map("succession_plans")
}

model SuccessionCandidate {
  id               String              @id @default(uuid())
  tenantId         String
  successionPlanId String
  successionPlan   SuccessionPlan      @relation(fields: [successionPlanId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  readiness        SuccessionReadiness @default(DEVELOPING)
  notes            String?

  @@unique([successionPlanId, employeeId])
  @@index([tenantId])
  @@map("succession_candidates")
}

enum ObjectiveType {
  INDIVIDUAL
  TEAM
}

enum ObjectiveStatus {
  ON_TRACK
  AT_RISK
  COMPLETED
}

model Objective {
  id          String          @id @default(uuid())
  tenantId    String
  employeeId  String?
  employee    Employee?       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  teamName    String?
  type        ObjectiveType
  title       String
  periodLabel String // e.g. "2026-Q1"
  status      ObjectiveStatus @default(ON_TRACK)
  createdAt   DateTime        @default(now())

  keyResults KeyResult[]

  @@index([tenantId])
  @@map("objectives")
}

model KeyResult {
  id           String    @id @default(uuid())
  tenantId     String
  objectiveId  String
  objective    Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  description  String
  targetValue  Float
  currentValue Float     @default(0)
  unit         String?

  @@index([tenantId])
  @@map("key_results")
}

enum FeedbackType {
  PEER
  MANAGER
  SELF
}

model Feedback {
  id            String       @id @default(uuid())
  tenantId      String
  fromUserId    String
  toEmployeeId  String
  toEmployee    Employee     @relation(fields: [toEmployeeId], references: [id], onDelete: Cascade)
  type          FeedbackType
  content       String
  createdAt     DateTime     @default(now())

  @@index([tenantId])
  @@index([tenantId, toEmployeeId])
  @@map("feedback_entries")
}

enum ReviewCycleStatus {
  OPEN
  CALIBRATION
  CLOSED
}

model ReviewCycle {
  id          String            @id @default(uuid())
  tenantId    String
  periodLabel String
  startDate   DateTime
  endDate     DateTime
  status      ReviewCycleStatus @default(OPEN)

  reviews PerformanceReview[]

  @@unique([tenantId, periodLabel])
  @@index([tenantId])
  @@map("review_cycles")
}

model PerformanceReview {
  id                String      @id @default(uuid())
  tenantId          String
  reviewCycleId     String
  reviewCycle       ReviewCycle @relation(fields: [reviewCycleId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  selfScore         Float?
  managerScore       Float?
  managerComments   String?
  calibratedScore   Float?

  @@unique([reviewCycleId, employeeId])
  @@index([tenantId])
  @@map("performance_reviews")
}

enum JobPostingStatus {
  OPEN
  CLOSED
}

model JobPosting {
  id              String           @id @default(uuid())
  tenantId        String
  title           String
  department      String?
  establishmentId String?
  establishment   Establishment?   @relation(fields: [establishmentId], references: [id])
  description     String?
  status          JobPostingStatus @default(OPEN)
  createdAt       DateTime         @default(now())

  applications JobApplication[]

  @@index([tenantId])
  @@map("job_postings")
}

model Candidate {
  id        String   @id @default(uuid())
  tenantId  String
  firstName String
  lastName  String
  email     String?
  phone     String?
  resumeUrl String?
  createdAt DateTime @default(now())

  applications JobApplication[]

  @@index([tenantId])
  @@map("candidates")
}

enum ApplicationStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

model JobApplication {
  id              String           @id @default(uuid())
  tenantId        String
  jobPostingId    String
  jobPosting      JobPosting       @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  candidateId     String
  candidate       Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  stage           ApplicationStage @default(APPLIED)
  recruiterUserId String?
  hiredEmployeeId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([jobPostingId, candidateId])
  @@index([tenantId])
  @@map("job_applications")
}

// ---------------------------------------------------------------------
// Praxis IPM (section 8) — fully modeled and implemented in
// src/ipm. Built on top of Praxis RH (Employee, PayslipLine, LeaveRequest,
// PayoutsService) per the interconnections in section 10 — see
// docs/ARCHITECTURE.md for which direction each dependency runs.
// ---------------------------------------------------------------------

enum IpmCardStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

// One beneficiary record per employee affiliated with the IPM — the
// "salarié" in section 8.1. `cardStatus` is the manually-set status
// (a gestionnaire can suspend/revoke directly); the *effective* status
// also folds in the linked employee's current employment status
// (section 10.2), computed at read time in IpmService rather than kept
// eagerly in sync, since a suspended contract must never leave a stale
// "ACTIVE" card behind.
model IpmBeneficiary {
  id                  String        @id @default(uuid())
  tenantId            String
  employeeId          String        @unique
  employee            Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cardNumber          String
  cardStatus          IpmCardStatus @default(ACTIVE)
  suspendedAt         DateTime?
  suspensionReason    String?
  coverageRatePercent Int           @default(80)
  createdAt           DateTime      @default(now())

  dependents         IpmDependent[]
  contributions      IpmContribution[]
  reimbursementCases IpmReimbursementCase[]

  @@unique([tenantId, cardNumber])
  @@index([tenantId])
  @@map("ipm_beneficiaries")
}

enum IpmDependentRelationship {
  CONJOINT
  ENFANT
  AUTRE
}

model IpmDependent {
  id            String                   @id @default(uuid())
  tenantId      String
  beneficiaryId String
  beneficiary   IpmBeneficiary           @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String
  dateOfBirth   DateTime?
  relationship  IpmDependentRelationship
  cardNumber    String
  isActive      Boolean                  @default(true)
  createdAt     DateTime                 @default(now())

  @@unique([tenantId, cardNumber])
  @@index([tenantId])
  @@map("ipm_dependents")
}

// "L'assiette de cotisation IPM alimentée par la paie réelle" (10.1):
// grossSalaryFcfa is read directly from that period's PayslipLine, never
// re-entered; assietteFcfa is the same figure capped at the plafond.
model IpmContribution {
  id                String   @id @default(uuid())
  tenantId          String
  beneficiaryId     String
  beneficiary       IpmBeneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  periodYear        Int
  periodMonth       Int
  grossSalaryFcfa   Int
  assietteFcfa      Int
  ratePercent       Float
  employerShareFcfa Int
  employeeShareFcfa Int
  status            String  @default("DUE") // DUE | PAID | LATE
  createdAt         DateTime @default(now())

  @@unique([beneficiaryId, periodYear, periodMonth])
  @@index([tenantId])
  @@map("ipm_contributions")
}

model IpmProvider {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  category  String // PHARMACIE | CLINIQUE | DENTAIRE | OPTIQUE | LABORATOIRE | AUTRE
  address   String?
  phone     String?
  createdAt DateTime @default(now())

  tariffs IpmTariff[]

  @@index([tenantId])
  @@map("ipm_providers")
}

model IpmTariff {
  id            String      @id @default(uuid())
  tenantId      String
  providerId    String
  provider      IpmProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  actCode       String
  actLabel      String
  tariffFcfa    Int
  effectiveFrom DateTime    @default(now())

  @@index([tenantId])
  @@map("ipm_tariffs")
}

enum IpmCapCategory {
  DENTAIRE
  OPTIQUE
  HOSPITALISATION
  PHARMACIE
  AUTRE
}

// Per-tenant annual ceiling by care category (section 8.5). A tenant
// with no row for a category is treated as uncapped for it — configure
// explicitly rather than silently defaulting to a number nobody chose.
model IpmAnnualCap {
  id            String         @id @default(uuid())
  tenantId      String
  category      IpmCapCategory
  annualCapFcfa Int

  @@unique([tenantId, category])
  @@index([tenantId])
  @@map("ipm_annual_caps")
}

enum IpmCaseStatus {
  SUBMITTED
  PENDING_MEDICAL_REVIEW
  APPROVED
  REJECTED
  PAID
}

model IpmReimbursementCase {
  id                    String        @id @default(uuid())
  tenantId              String
  beneficiaryId         String
  beneficiary           IpmBeneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  dependentId           String?
  category              IpmCapCategory
  invoiceNumber         String
  providerName          String?
  amountClaimedFcfa     Int
  amountApprovedFcfa    Int?
  status                IpmCaseStatus  @default(SUBMITTED)
  documentUrls          Json? // uploaded invoice/prescription photos — see StorageService
  rejectionReasonCode   String?
  justifiesAbsenceFrom  DateTime? // section 10.3: maladie/hospitalisation -> RH absence justification
  justifiesAbsenceTo    DateTime?
  linkedLeaveRequestId  String?
  reviewedBy            String?
  reviewedAt            DateTime?
  paymentTransactionId  String?       @unique
  createdAt             DateTime      @default(now())

  // "Un même numéro de facture ne peut être soumis deux fois pour le
  // même bénéficiaire" (section 8.5 acceptance criteria) — scoped to
  // the beneficiary, not tenant-wide, since two different employees
  // could legitimately have same-numbered invoices from different visits.
  @@unique([tenantId, beneficiaryId, invoiceNumber])
  @@index([tenantId])
  @@map("ipm_reimbursement_cases")
}

// ---------------------------------------------------------------------
// Pack Intérim — schema scaffold only (Phase 4). Requires RH module.
// ---------------------------------------------------------------------

model InterimMission {
  id                String   @id @default(uuid())
  tenantId          String
  clientName        String
  siteName          String
  startDate         DateTime
  endDate           DateTime?
  billingRateFcfaPerHour Int
  payRateFcfaPerHour     Int
  createdAt         DateTime @default(now())

  @@index([tenantId])
  @@map("interim_missions")
}

model InterimAssignment {
  id          String   @id @default(uuid())
  tenantId    String
  missionId   String
  employeeId  String
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@map("interim_assignments")
}

model InterimTimesheet {
  id           String   @id @default(uuid())
  tenantId     String
  assignmentId String
  date         DateTime
  hours        Float
  clientApproved Boolean @default(false)
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@map("interim_timesheets")
}

model InterimAdvance {
  id          String   @id @default(uuid())
  tenantId    String
  employeeId  String
  amountFcfa  Int
  status      String   @default("REQUESTED")
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@map("interim_advances")
}

// ---------------------------------------------------------------------
// Formation (section 6.15) & Engagement (6.16) — schema scaffold only,
// same reasoning as the IPM/Interim scaffold above: present so the
// modules activate without a migration later, not yet wired to a
// service/controller. DevelopmentPlan.recommendedActions (Phase 2,
// built above) is the natural integration point once this is built out.
// ---------------------------------------------------------------------

model ActionFormation {
  id             String   @id @default(uuid())
  tenantId       String
  title          String
  provider       String?
  type           String   @default("INTERNAL") // INTERNAL | EXTERNAL
  durationHours  Float?
  createdAt      DateTime @default(now())

  @@index([tenantId])
  @@map("actions_formation")
}

model FormationEnrollment {
  id                     String    @id @default(uuid())
  tenantId               String
  employeeId             String
  actionFormationId      String
  status                 String    @default("ENROLLED")
  completedAt            DateTime?
  certificationExpiresAt DateTime?

  @@index([tenantId])
  @@map("formation_enrollments")
}

model EnqueteEngagement {
  id       String   @id @default(uuid())
  tenantId String
  question String
  sentAt   DateTime @default(now())

  @@index([tenantId])
  @@map("enquetes_engagement")
}

model PulseSurveyResponse {
  id        String   @id @default(uuid())
  tenantId  String
  surveyId  String
  teamName  String? // aggregation key — never the individual employee, per "aucun résultat individuel n'est identifiable"
  score     Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@map("pulse_survey_responses")
}
