# Local dev defaults below. In production (e.g. Railway): DATABASE_URL
# comes from the linked Postgres plugin, WEB_ORIGIN must be the deployed
# frontend's URL (e.g. https://praxis.vercel.app) so CORS allows it, and
# PORT is injected automatically by the platform — leave it unset.
DATABASE_URL="postgresql://praxis:praxis@localhost:5432/praxis?schema=public"
JWT_SECRET="change-me-in-production"
STORAGE_DIR="./storage"
WEB_ORIGIN="http://localhost:3000"
PORT=4000
